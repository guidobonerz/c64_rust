; rust64 runtime: program start/exit, panic, memory and arithmetic helpers.
;
; Registers (normal RAM, not zero page): rt_a, rt_b, rt_r, rt_t (8 bytes each),
; rt_n (operand size in bytes for the arithmetic helpers, byte count for
; rt_memcpy/rt_memset), rt_jvec, rt_args/rt_ret (calls through pointers).
; Pointer registers in zero page: zp_p0, zp_p1, zp_p2 ($f9-$fe).
; Zero page $02-$8f: zp statics (saved at start, restored at exit).

zp_p0 = $fb
zp_p1 = $fd
zp_p2 = $f9

; BSS of the runtime (RT_BSS = 160 + 87 bytes in the backend)
rt_zpsave  = __bss          ; 142 bytes: $02-$8f
rt_sp      = __bss + 142

; rt_start and rt_exit are generated by the backend (start_exit in
; codegen.rs): only what the program needs.

; A panic (failed assert, unreachable code, abort): red border, return to BASIC.
rt_panic:
        lda #2
        sta $d020
        jmp rt_exit

; Call the routine whose address is in rt_jvec (calls through pointers).
; The vector is the operand of the jmp: an indirect jmp would read a wrong
; high byte if the vector happened to lie across a page boundary.
rt_jsrind:
        jmp $ffff
rt_jvec = rt_jsrind + 1

; rt_ctx_save / rt_ctx_restore (for interrupt dispatchers) are generated
; by the backend: they save what code reached through function pointers
; can change (see ctx_save in codegen.rs).

; Copy rt_n bytes from (zp_p0) to (zp_p1), front to back.
rt_memcpy:
        ldy #0
        ldx rt_n+1
        beq @rest
@page:  lda (zp_p0),y
        sta (zp_p1),y
        iny
        bne @page
        inc zp_p0+1
        inc zp_p1+1
        dex
        bne @page
@rest:  ldx rt_n
        beq @done
@byte:  lda (zp_p0),y
        sta (zp_p1),y
        iny
        dex
        bne @byte
@done:  rts

; Set rt_n bytes at (zp_p1) to A.
rt_memset:
        ldy #0
        ldx rt_n+1
        beq @rest
@page:  sta (zp_p1),y
        iny
        bne @page
        inc zp_p1+1
        dex
        bne @page
@rest:  ldy rt_n
        beq @done
@byte:  dey
        sta (zp_p1),y
        bne @byte
@done:  rts

; Compare rt_n bytes at (zp_p0) and (zp_p1) unsigned: A = 0 if equal,
; $ff if the first differing byte is smaller in (zp_p0), 1 if larger.
rt_memcmp:
        ldy #0
        ldx rt_n+1
        beq @rest
@page:  lda (zp_p0),y
        cmp (zp_p1),y
        bne @diff
        iny
        bne @page
        inc zp_p0+1
        inc zp_p1+1
        dex
        bne @page
@rest:  ldx rt_n
        beq @eq
@byte:  lda (zp_p0),y
        cmp (zp_p1),y
        bne @diff
        iny
        dex
        bne @byte
@eq:    lda #0
        rts
@diff:  bcc @lt
        lda #1
        rts
@lt:    lda #$ff
        rts

; rt_r = rt_a * rt_b (one byte, wrapping). Shift-and-add from the low bit
; of rt_b; done as soon as no bits of rt_b are left.
rt_mul8:
        lda #0
        beq @enter
@add:   clc
        adc rt_a
@loop:  asl rt_a
@enter: lsr rt_b
        bcs @add
        bne @loop
        sta rt_r
        rts

; rt_r = rt_a * rt_b (two bytes, wrapping). The low byte of the product
; is kept in A.
rt_mul16:
        lda #0
        sta rt_r+1
        beq @enter
@add:   clc
        adc rt_a
        tax
        lda rt_r+1
        adc rt_a+1
        sta rt_r+1
        txa
@loop:  asl rt_a
        rol rt_a+1
@enter: lsr rt_b+1
        ror rt_b
        bcs @add
        bne @loop
        ldx rt_b+1
        bne @loop
        sta rt_r
        rts

; rt_r = rt_a * rt_b (rt_n bytes, wrapping). rt_cnt is the number of
; bytes of rt_b that still hold bits: only those are shifted, and the
; loop ends when none are left.
rt_mul:
        ldx rt_n
        lda #0
@clr:   sta rt_r-1,x
        dex
        bne @clr
        ldx rt_n
@top:   lda rt_b-1,x
        bne @go
        dex
        bne @top
        rts                     ; b = 0
@go:    stx rt_cnt
@bit:   ldx rt_cnt              ; b >>= 1, low bit into carry
        lsr rt_b-1,x
        bne @low
        dec rt_cnt              ; the top byte is used up
@low:   dex
        beq @shd
@shb:   ror rt_b-1,x
        dex
        bne @shb
@shd:   bcc @skip
        ldx #0                  ; r += a
        ldy rt_n
        clc
@add:   lda rt_r,x
        adc rt_a,x
        sta rt_r,x
        inx
        dey
        bne @add
@skip:  lda rt_cnt
        beq @done
        ldx #0                  ; a <<= 1
        ldy rt_n
        clc
@sha:   rol rt_a,x
        inx
        dey
        bne @sha
        beq @bit
@done:  rts

; rt_r = rt_a * rt_b (four bytes, wrapping).
;
; The signs come off first (the product of the magnitudes is negated at the
; end if they differ), so a small negative number is a small number here
; too. If both magnitudes fit into 16 bits, rt_mul16u does the work.
rt_mul32:
        lda rt_a+3
        eor rt_b+3
        sta rt_sgn              ; bit 7: the sign of the product
        lda rt_a+3
        bpl @apos
        ldx #0
        jsr rt_neg4
@apos:  lda rt_b+3
        bpl @bpos
        ldx #rt_b-rt_a
        jsr rt_neg4
@bpos:  lda rt_a+2
        ora rt_a+3
        ora rt_b+2
        ora rt_b+3
        bne @wide
        jsr rt_mul16u
        jmp @sign
        ; 32 x 32 -> 32: shift and add, as long as bits of rt_b are left
@wide:  lda #0
        sta rt_r
        sta rt_r+1
        sta rt_r+2
        sta rt_r+3
@wbit:  lsr rt_b+3
        ror rt_b+2
        ror rt_b+1
        ror rt_b
        bcc @wskip
        clc
        lda rt_r
        adc rt_a
        sta rt_r
        lda rt_r+1
        adc rt_a+1
        sta rt_r+1
        lda rt_r+2
        adc rt_a+2
        sta rt_r+2
        lda rt_r+3
        adc rt_a+3
        sta rt_r+3
@wskip: asl rt_a
        rol rt_a+1
        rol rt_a+2
        rol rt_a+3
        lda rt_b
        ora rt_b+1
        ora rt_b+2
        ora rt_b+3
        bne @wbit
@sign:  bit rt_sgn
        bpl @done
        ldx #rt_r-rt_a
        jmp rt_neg4
@done:  rts

; rt_r (four bytes) = rt_a * rt_b (two bytes each, unsigned). The product
; is built from the top: 16 rounds, or 8 if one of the two fits into a
; byte (the smaller one is the multiplier).
rt_mul16u:
        lda rt_b+1
        beq @order
        lda rt_a+1
        bne @order
        ldx rt_a
        lda rt_b
        sta rt_a
        stx rt_b
        lda rt_b+1
        sta rt_a+1
        lda #0
        sta rt_b+1
@order: ldx #16
        lda rt_b+1
        bne @count
        ldx #8
@count: stx rt_cnt
        lda #0                  ; A is the top byte of the product
        sta rt_r+2
@bit:   lsr rt_b+1
        ror rt_b
        bcc @rot
        tay
        clc
        lda rt_r+2
        adc rt_a
        sta rt_r+2
        tya
        adc rt_a+1
@rot:   ror
        ror rt_r+2
        ror rt_r+1
        ror rt_r
        dex
        bne @bit
        sta rt_r+3
        lda rt_cnt
        cmp #8
        bne @done
        lda rt_r+1              ; 8 rounds: the product is one byte too high
        sta rt_r
        lda rt_r+2
        sta rt_r+1
        lda rt_r+3
        sta rt_r+2
        stx rt_r+3
@done:  rts

; rt_r (four bytes) = rt_a * rt_b (two bytes each, signed).
rt_mul16s:
        lda rt_a+1
        eor rt_b+1
        sta rt_sgn              ; bit 7: the sign of the product
        lda rt_a+1
        bpl @apos
        sec
        lda #0
        sbc rt_a
        sta rt_a
        lda #0
        sbc rt_a+1
        sta rt_a+1
@apos:  lda rt_b+1
        bpl @bpos
        sec
        lda #0
        sbc rt_b
        sta rt_b
        lda #0
        sbc rt_b+1
        sta rt_b+1
@bpos:  jsr rt_mul16u
        bit rt_sgn
        bpl @done
        ldx #rt_r-rt_a
        jmp rt_neg4
@done:  rts

; Negates the four bytes at rt_a + X.
rt_neg4:
        ldy #4
        sec
@neg:   lda #0
        sbc rt_a,x
        sta rt_a,x
        inx
        dey
        bne @neg
        rts

; Unsigned rt_a / rt_b, four bytes: quotient in rt_a, remainder in rt_r.
;
; Leading zero bytes of rt_a are not divided (8 rounds less each), and with
; a divisor below 65536 the remainder is two bytes wide.
rt_udiv32:
        lda #0
        sta rt_r
        sta rt_r+1
        sta rt_r+2
        sta rt_r+3
        ldx #32
@lead:  lda rt_a+3
        bne @start
        lda rt_a+2
        sta rt_a+3
        lda rt_a+1
        sta rt_a+2
        lda rt_a
        sta rt_a+1
        lda #0
        sta rt_a
        txa
        sec
        sbc #8
        tax
        bne @lead
        rts                     ; 0 / b
@start: lda rt_b+2
        ora rt_b+3
        bne @wide
@bit:   asl rt_a
        rol rt_a+1
        rol rt_a+2
        rol rt_a+3
        rol rt_r
        rol rt_r+1
        bcs @sub                ; 17 bits: more than the divisor
        lda rt_r
        cmp rt_b
        lda rt_r+1
        sbc rt_b+1
        bcc @next
@sub:   lda rt_r
        sbc rt_b
        sta rt_r
        lda rt_r+1
        sbc rt_b+1
        sta rt_r+1
        inc rt_a                ; quotient bit (bit 0 is 0 after the shift)
@next:  dex
        bne @bit
        rts
@wide:  asl rt_a
        rol rt_a+1
        rol rt_a+2
        rol rt_a+3
        rol rt_r
        rol rt_r+1
        rol rt_r+2
        rol rt_r+3
        bcs @wbig               ; 33 bits: more than the divisor
        sec
        lda rt_r
        sbc rt_b
        sta rt_t
        lda rt_r+1
        sbc rt_b+1
        sta rt_t+1
        lda rt_r+2
        sbc rt_b+2
        sta rt_t+2
        lda rt_r+3
        sbc rt_b+3
        bcc @wnext              ; r < b
        sta rt_r+3
        lda rt_t+2
        sta rt_r+2
        lda rt_t+1
        sta rt_r+1
        lda rt_t
        sta rt_r
@winc:  inc rt_a
@wnext: dex
        bne @wide
        rts
@wbig:  lda rt_r
        sbc rt_b
        sta rt_r
        lda rt_r+1
        sbc rt_b+1
        sta rt_r+1
        lda rt_r+2
        sbc rt_b+2
        sta rt_r+2
        lda rt_r+3
        sbc rt_b+3
        sta rt_r+3
        jmp @winc

; Unsigned rt_a / rt_b, one byte: quotient in rt_a, remainder in rt_r.
rt_udiv8:
        lda #0
        ldx #8
@bit:   asl rt_a
        rol
        cmp rt_b
        bcc @next
        sbc rt_b
        inc rt_a
@next:  dex
        bne @bit
        sta rt_r
        rts

; Unsigned rt_a / rt_b, two bytes: quotient in rt_a, remainder in rt_r.
rt_udiv16:
        lda #0
        sta rt_r+1
        ldx #16
@bit:   asl rt_a
        rol rt_a+1
        rol
        rol rt_r+1
        tay
        cmp rt_b
        lda rt_r+1
        sbc rt_b+1
        bcc @keep
        sta rt_r+1
        tya
        sbc rt_b
        tay
        inc rt_a
@keep:  tya
        dex
        bne @bit
        sta rt_r
        rts

; Unsigned rt_a / rt_b: quotient in rt_a, remainder in rt_r (rt_n bytes).
rt_udiv:
        ldx rt_n
        lda #0
@clr:   sta rt_r-1,x
        dex
        bne @clr
        lda rt_n
        asl
        asl
        asl
        sta rt_cnt
@bit:   ldx #0                  ; (r:a) <<= 1
        ldy rt_n
        clc
@sha:   rol rt_a,x
        inx
        dey
        bne @sha
        ldx #0
        ldy rt_n
@shr:   rol rt_r,x
        inx
        dey
        bne @shr
        ldx #0                  ; t = r - b
        ldy rt_n
        sec
@sub:   lda rt_r,x
        sbc rt_b,x
        sta rt_t,x
        inx
        dey
        bne @sub
        bcc @next               ; r < b
        ldx rt_n
@cpy:   lda rt_t-1,x
        sta rt_r-1,x
        dex
        bne @cpy
        inc rt_a                ; quotient bit (bit 0 is 0 after the shift)
@next:  dec rt_cnt
        bne @bit
        rts

; Signed rt_a / rt_b: quotient in rt_a, remainder in rt_r (sign of rt_a).
rt_sdiv:
        ldx rt_n
        lda rt_a-1,x
        sta rt_sgn              ; bit 7: sign of the remainder
        eor rt_b-1,x
        sta rt_sgnq             ; bit 7: sign of the quotient
        lda rt_a-1,x
        bpl @apos
        jsr rt_nega
@apos:  ldx rt_n
        lda rt_b-1,x
        bpl @bpos
        ldx #0
        ldy rt_n
        sec
@negb:  lda #0
        sbc rt_b,x
        sta rt_b,x
        inx
        dey
        bne @negb
@bpos:  jsr rt_udiv
        bit rt_sgnq
        bpl @qpos
        jsr rt_nega
@qpos:  bit rt_sgn
        bpl @done
        ldx #0
        ldy rt_n
        sec
@negr:  lda #0
        sbc rt_r,x
        sta rt_r,x
        inx
        dey
        bne @negr
@done:  rts

rt_nega:
        ldx #0
        ldy rt_n
        sec
@neg:   lda #0
        sbc rt_a,x
        sta rt_a,x
        inx
        dey
        bne @neg
        rts

; Bit counts of rt_a (rt_n bytes), result in A.
rt_ctpop:
        lda #0
        sta rt_cnt
        ldx rt_n
@byte:  lda rt_a-1,x
@bit:   asl
        bcc @nz
        inc rt_cnt
@nz:    cmp #0
        bne @bit
        dex
        bne @byte
        lda rt_cnt
        rts

rt_ctlz:
        ldy #0
        ldx rt_n
@byte:  lda rt_a-1,x
        bne @found
        tya
        clc
        adc #8
        tay
        dex
        bne @byte
        tya
        rts
@found: asl
        bcs @done
        iny
        jmp @found
@done:  tya
        rts

rt_cttz:
        ldy #0
        ldx #0
@byte:  lda rt_a,x
        bne @found
        tya
        clc
        adc #8
        tay
        inx
        cpx rt_n
        bne @byte
        tya
        rts
@found: lsr
        bcs @done
        iny
        jmp @found
@done:  tya
        rts

; The runtime registers rt_cnt, rt_sgn, rt_sgnq, rt_n, rt_a, rt_b, rt_r and
; rt_t (39 bytes in this order: 1, 1, 1, 4 and four times 8) are defined by
; the code generator, in front of the code: in the zero page where there is
; room for the ones the program uses, else from __bss + 160. rt_save is the
; first of them and rt_save_n their number of bytes (rt_ctx_save).
; The arguments and the result of a call through a function pointer:
rt_args     = __bss + 199
rt_ret      = __bss + 231
